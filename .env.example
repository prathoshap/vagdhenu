# Vāgdhenu API — environment variables
# Copy to .env and fill in as needed. All have sensible defaults.

# Hugging Face model repo (weights + vocab)
VAGDHENU_HF=prathoshap/vagdhenu

# Weight file paths (defaults point to models/ downloaded by scripts/download_weights.py)
VAGDHENU_VOICE=/app/models/voice_steer_ema_2026-06-17.pt
VAGDHENU_VOC=/app/models/voc_bigvgan_EMA_2026-06-11.pth
